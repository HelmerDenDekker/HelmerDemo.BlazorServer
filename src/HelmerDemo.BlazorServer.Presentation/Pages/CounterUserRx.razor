@page "/counteruserrx"
@using HelmerDemo.BlazorServer.Shared.Tools.Extensions

@{
	MaxValue = 20;
}

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p>This demonstrates the use ReactiveX to have the counter in sync for one user in multiple tabs.</p>

@if (!CounterContent.ErrorMessage.IsNullOrEmpty())
{
	<p role="status" class="@CounterContent.ErrorStyle">@CounterContent.ErrorMessage</p>
}
<p role="status" class="@CounterContent.ErrorStyle">Current count: @CounterContent.CurrentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount" disabled="@CounterContent.Disabled">Click me</button>
